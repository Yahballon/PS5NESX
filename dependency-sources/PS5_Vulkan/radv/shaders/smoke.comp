#version 450
// PS5 Vulkan - RADV smoke test: every invocation writes a value its index names.
// Copyright (C) 2026 Mihawk-99
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Values { uint v[]; } values;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    values.v[i] = i * 3u + 7u;
}
